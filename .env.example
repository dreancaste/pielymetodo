# Copy this file to .env.local for local development.
# In production (Vercel), set these as Environment Variables in the project
# settings instead — never commit real values.

# Bank alias shown to the customer after they submit an order, so they can
# transfer the total and send you the proof of payment.
BANK_ALIAS=
# Account holder name shown alongside the alias (optional, but recommended
# so the customer can confirm they're transferring to the right account).
BANK_HOLDER=

# CallMeBot — used to WhatsApp the store owner with the order details as
# soon as a customer submits their cart.
# Get an API key by messaging the CallMeBot number from the owner's own
# WhatsApp (see https://www.callmebot.com/blog/free-api-whatsapp-messages/).
CALLMEBOT_API_KEY=
# Owner's WhatsApp number in international format, no "+" or spaces (e.g. 5491122223333).
CALLMEBOT_PHONE=

# Public-facing contact number shown to customers to send their payment
# proof and coordinate delivery (wa.me link). Same format as CALLMEBOT_PHONE.
NEXT_PUBLIC_CONTACT_PHONE=
