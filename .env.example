# Copy this file to .env.local for local development.
# In production (Vercel), set these as Environment Variables in the project
# settings instead — never commit real values.

# Public URL of the deployed site (used for Mercado Pago redirect/webhook URLs).
SITE_URL=http://localhost:3000

# Mercado Pago — Developers panel > Your integrations > Credentials.
# Use the TEST- access token first to validate the flow before going live.
MP_ACCESS_TOKEN=
# Set to "true" while testing with a TEST- access token so checkout uses the
# sandbox_init_point instead of the live init_point.
MP_USE_SANDBOX=false

# CallMeBot — used to WhatsApp the store owner when a payment is approved.
# Get an API key by messaging the CallMeBot number from the owner's own
# WhatsApp (see https://www.callmebot.com/blog/free-api-whatsapp-messages/).
CALLMEBOT_API_KEY=
# Owner's WhatsApp number in international format, no "+" or spaces (e.g. 5491122223333).
CALLMEBOT_PHONE=

# Public-facing contact number shown to customers on payment result pages
# (wa.me link). Same format as CALLMEBOT_PHONE.
NEXT_PUBLIC_CONTACT_PHONE=
